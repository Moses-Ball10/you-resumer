# Copy to backend/.env if you need to change a setting. backend/.env is ignored by git.
# The server keeps no AI key: every visitor adds their own Gemini (and optionally Groq)
# key in the page; it is stored in their browser and sent with their requests.

# Saved videos and results. SQLite locally; on Render, a free Neon Postgres URL
# (postgresql://user:password@host/db?sslmode=require), set in Render's environment settings.
# DATABASE_URL=sqlite:///./data.db

# Address(es) of the frontend allowed to call this API, as a JSON list.
# CORS_ORIGINS=["http://localhost:3000"]

# GEMINI_MODEL=gemini-flash-lite-latest
# GROQ_MODEL=openai/gpt-oss-120b

# Limits per visitor (by IP address)
# MAX_VIDEO_SECONDS=10800
# VIDEOS_PER_HOUR=30
# AI_REQUESTS_PER_HOUR=120

# Later, our own GPU server running vLLM (tried first when set):
# CUSTOM_BASE_URL=https://<our-gpu-server>/v1
# CUSTOM_API_KEY=
# CUSTOM_MODEL=
